[Unit]
Description=Wallio web app (Next.js)
After=network-online.target wallio-api.service
Wants=network-online.target

[Service]
User=wallio
Group=wallio
WorkingDirectory=/opt/wallio/current/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# Only used when /api reaches Next (not behind the Caddy below). Same box: the local API.
Environment=WALLIO_API_ORIGIN=http://127.0.0.1:8787
# Listens on localhost only; Caddy is the only public entry point.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=on-failure
RestartSec=2

# Hardening: read its code, write only the Next cache.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/wallio/current/web/.next/cache
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=768M

[Install]
WantedBy=multi-user.target
