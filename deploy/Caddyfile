# Public entry point. Only Caddy listens publicly (443); the API and Postgres
# listen on localhost. TLS certificates are automatic.
__WALLIO_DOMAIN__ {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		# flush_interval -1 streams SSE run events immediately
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
		}
	}

	handle {
		root * /opt/wallio/current/deploy/web
		try_files {path} /index.html
		file_server
	}
}
