[Unit]
Description=Wallio API
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=wallio
Group=wallio
WorkingDirectory=/opt/wallio/current/packages/api
EnvironmentFile=/etc/wallio/api.env
# Pins the runner's self-signed certificate (installed by deploy/runner/push-runner-secrets.sh).
# Node ignores a missing file with a warning, so this is safe before the runner exists.
Environment=NODE_EXTRA_CA_CERTS=/etc/wallio/runner-cert.pem
ExecStart=/usr/bin/node src/server.ts
Restart=on-failure
RestartSec=2

# Hardening: the API only needs to read its code and talk to Postgres and Vultr.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1G

[Install]
WantedBy=multi-user.target
