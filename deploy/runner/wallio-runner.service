[Unit]
Description=Wallio browser runner
After=network-online.target docker.service wallio-runner-firewall.service
Wants=network-online.target
Requires=docker.service wallio-runner-firewall.service

[Service]
User=wallio-runner
Group=wallio-runner
SupplementaryGroups=docker
WorkingDirectory=/opt/wallio-runner/current/packages/runner
EnvironmentFile=/etc/wallio/runner.env
ExecStart=/usr/bin/node src/main.ts
Restart=on-failure
RestartSec=2
# SIGTERM cancels any running job and verifies cleanup before exit.
TimeoutStopSec=60

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/wallio-runner /run/docker.sock
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target
