# Copy to .env (git-ignored) and fill in. Never commit real values.

# Vultr Serverless Inference subscription key (NOT the Vultr infrastructure API key)
VULTR_INFERENCE_API_KEY=
# Locked: the gateway refuses any other inference host.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Pinned after the capability gate (npm run smoke:inference)
INFERENCE_MODEL_TEXT=
INFERENCE_MODEL_VISION=

# ── Database (P2) ──
# Owner/superuser, used only for migrations and seeding.
DATABASE_ADMIN_URL=postgres://localhost:5432/wallio_dev
# App role. Must NOT be a superuser, so row-level security applies.
DATABASE_URL=postgres://wallio_app:wallio_dev_only@localhost:5432/wallio_dev
TEST_DATABASE_ADMIN_URL=postgres://localhost:5432/wallio_test
TEST_DATABASE_URL=postgres://wallio_app:wallio_dev_only@localhost:5432/wallio_test

# ── API server ──
PORT=8787
# mock = scripted demo runs until the orchestrator (P4) lands; live = real runner
RUN_MODE=mock
COOKIE_SECURE=false
# APP_ORIGIN=https://wallio.example
RUN_SPEND_CAP_MINOR=50
