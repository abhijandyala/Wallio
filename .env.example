# Copy to .env (git-ignored) and fill in. Never commit real values.

# Vultr Serverless Inference subscription key (NOT the Vultr infrastructure API key)
VULTR_INFERENCE_API_KEY=
# Locked: the gateway refuses any other inference host.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Pinned after the capability gate (npm run smoke:inference)
INFERENCE_MODEL_TEXT=
INFERENCE_MODEL_VISION=
