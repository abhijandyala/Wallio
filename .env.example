# Copy to .env (git-ignored) and fill in. Never commit real values.

# Vultr Serverless Inference subscription key (NOT the Vultr infrastructure API key)
VULTR_INFERENCE_API_KEY=
# Locked: the gateway refuses any other inference host.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Pinned after the capability gate (npm run smoke:inference)
INFERENCE_MODEL_TEXT=
INFERENCE_MODEL_VISION=

# ── Database (P2) ──
# Owner/superuser, used only for migrations and seeding.
DATABASE_ADMIN_URL=postgres://localhost:5432/wallio_dev
# App role. Must NOT be a superuser, so row-level security applies.
DATABASE_URL=postgres://wallio_app:wallio_dev_only@localhost:5432/wallio_dev
TEST_DATABASE_ADMIN_URL=postgres://localhost:5432/wallio_test
TEST_DATABASE_URL=postgres://wallio_app:wallio_dev_only@localhost:5432/wallio_test

# ── API server ──
PORT=8787
# mock = scripted demo runs until the orchestrator (P4) lands; live = real runner
RUN_MODE=mock
COOKIE_SECURE=false
# APP_ORIGIN=https://wallio.example
RUN_SPEND_CAP_MINOR=50

# ── Orchestrator (P4) ──
RUN_ESTIMATE_MINOR=5          # cents reserved per live run before dispatch
DAILY_SPEND_CAP_MINOR=500     # kill switch: no new runs once today's spend reaches this (cents)
RUN_DEADLINE_SECS=180         # hard execution deadline, enforced outside the executor
QUEUE_MAX_WAIT_SECS=120
MAX_QUEUED_RUNS=5
WORKER_LEASE_SECS=15
LIVE_CONCURRENCY=1            # one browser runner
MOCK_STEP_MS=700

# ── Browser runner (P5) — Adhvik's daemon on the private VPC network ──
# Live mode needs both. Without them, live comparisons fail honestly with runner_unavailable.
# deploy/runner/push-runner-secrets.sh (Adhvik's branch) writes the four RUNNER_* values on the server.
# RUNNER_URL=https://10.5.96.x:8443
# RUNNER_SHARED_TOKEN=            # >= 24 random characters, same value on the runner
# RUNNER_APPROVAL_KEY=            # signs approval tokens; the runner verifies them before any submit
# RUNNER_CA_FILE=/etc/wallio/runner-cert.pem   # runner's self-signed cert, trusted via NODE_EXTRA_CA_CERTS
RUNNER_TIMEOUT_MS=60000          # per runner call; never below 50000 (runner's navigate + watchdog)
# EVAL_ORIGIN=https://eval.wallio.example   # owned eval page; defaults to eval.<APP_ORIGIN host>
