{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "purpose": {
      "type": "string",
      "maxLength": 200
    },
    "allowedHosts": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "deadlineMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 180000
        },
        "maxActions": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "maxScreenshots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      },
      "required": [
        "deadlineMs",
        "maxActions",
        "maxScreenshots"
      ]
    },
    "fillKinds": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "name",
          "given_name",
          "family_name",
          "organization",
          "tel",
          "plan_choice",
          "quantity",
          "choice",
          "free_text",
          "checkbox",
          "consent"
        ]
      }
    }
  },
  "required": [
    "jobId",
    "runId",
    "correlationId",
    "purpose",
    "allowedHosts",
    "limits"
  ],
  "$id": "wallio/runner/RunnerJobCreate@0.1.0"
}
