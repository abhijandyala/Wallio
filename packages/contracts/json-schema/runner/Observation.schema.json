{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 300
    },
    "httpStatus": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "redirectChain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pageFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "textExcerpt": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "textSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "elements": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^e\\d{1,4}$"
              },
              "role": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "maxLength": 300
              },
              "href": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inputType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "targetHost": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "field": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "email",
                          "name",
                          "given_name",
                          "family_name",
                          "organization",
                          "tel",
                          "plan_choice",
                          "quantity",
                          "choice",
                          "free_text",
                          "checkbox",
                          "consent",
                          "sensitive"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "options": {
                        "anyOf": [
                          {
                            "maxItems": 30,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string",
                                  "maxLength": 200
                                },
                                "label": {
                                  "type": "string",
                                  "maxLength": 200
                                },
                                "selected": {
                                  "type": "boolean"
                                }
                              },
                              "required": [
                                "value",
                                "label",
                                "selected"
                              ]
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "label",
                      "required",
                      "value",
                      "options"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "needsApproval": {
                "type": "boolean"
              }
            },
            "required": [
              "ref",
              "role",
              "name",
              "tag",
              "text",
              "href",
              "inputType",
              "targetHost"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "screenshot": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "mimeType": {
              "type": "string",
              "const": "image/png"
            }
          },
          "required": [
            "artifactId",
            "sha256",
            "width",
            "height",
            "bytes",
            "mimeType"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "blocked": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "captcha",
                "mfa",
                "login_required",
                "access_denied",
                "http_error",
                "egress_denied",
                "download_blocked",
                "payment_required",
                "verification_required"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "detail"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "handoff": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "captcha",
                "mfa",
                "login_required",
                "access_denied",
                "http_error",
                "egress_denied",
                "download_blocked",
                "payment_required",
                "verification_required"
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "host": {
              "type": "string",
              "maxLength": 253
            },
            "prepared": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "email",
                      "name",
                      "given_name",
                      "family_name",
                      "organization",
                      "tel",
                      "plan_choice",
                      "quantity",
                      "choice",
                      "free_text",
                      "checkbox",
                      "consent",
                      "sensitive"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "label",
                  "kind",
                  "value"
                ]
              }
            },
            "remaining": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "required": [
            "reason",
            "url",
            "host",
            "prepared",
            "remaining"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "deniedRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "reason"
        ]
      }
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "url",
    "title",
    "httpStatus",
    "redirectChain",
    "pageFingerprint",
    "textExcerpt",
    "textSha256",
    "elements",
    "screenshot",
    "blocked",
    "deniedRequests",
    "capturedAt"
  ],
  "$id": "wallio/runner/Observation@0.1.0"
}
