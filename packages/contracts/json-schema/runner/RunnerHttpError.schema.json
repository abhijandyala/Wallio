          "enum": [
            "invalid_action",
            "egress_denied",
            "navigation_failed",
            "element_not_found",
            "element_stale",
            "approval_token_invalid",
            "action_timeout",
            "deadline_exceeded",
            "action_limit_reached",
            "screenshot_limit_reached",
            "browser_crashed",
