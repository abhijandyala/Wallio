{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "cleaned",
        "cleanup_failed"
      ]
    },
    "containerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "containerRemoved": {
      "type": "boolean"
    },
    "volumeRemoved": {
      "type": "boolean"
    },
    "verifiedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "actionsExecuted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "screenshotsTaken": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deniedRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "url",
          "reason",
          "at"
        ]
      }
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "jobId",
    "status",
    "containerId",
    "containerRemoved",
    "volumeRemoved",
    "verifiedAt",
    "actionsExecuted",
    "screenshotsTaken",
    "deniedRequests",
    "detail"
  ],
  "$id": "wallio/runner/CleanupReport@0.1.1"
}
