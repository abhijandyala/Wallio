{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionType": {
      "type": "string",
      "enum": [
        "submit_form"
      ]
    },
    "targetOrigin": {
      "type": "string",
      "format": "uri"
    },
    "targetUrl": {
      "type": "string",
      "format": "uri"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "label",
          "value"
        ]
      }
    },
    "consequence": {
      "type": "string",
      "minLength": 1
    },
    "screenshotEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "intentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined",
        "expired",
        "consumed",
        "invalidated"
      ]
    }
  },
  "required": [
    "id",
    "runId",
    "actionType",
    "targetOrigin",
    "targetUrl",
    "fields",
    "consequence",
    "screenshotEvidenceId",
    "intentHash",
    "createdAt",
    "expiresAt",
    "status"
  ],
  "$id": "wallio/api/ApprovalIntent@0.3.0"
}
