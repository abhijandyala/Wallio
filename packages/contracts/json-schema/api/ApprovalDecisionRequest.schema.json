{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "decline"
      ]
    },
    "intentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "decision",
    "intentHash"
  ],
  "$id": "wallio/api/ApprovalDecisionRequest@0.2.0"
}
