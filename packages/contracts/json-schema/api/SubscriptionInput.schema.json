{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "toolId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plan": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "known": {
              "type": "boolean",
              "const": true
            },
            "amountMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "known",
            "amountMinor",
            "currency"
          ]
        },
        {
          "type": "object",
          "properties": {
            "known": {
              "type": "boolean",
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "known",
            "reason"
          ]
        }
      ]
    },
    "cadence": {
      "type": "string",
      "enum": [
        "monthly",
        "annual",
        "usage_based",
        "free"
      ]
    },
    "seats": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "renewalDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "taxIncluded": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "toolId",
    "plan",
    "price",
    "cadence",
    "seats",
    "renewalDate",
    "taxIncluded"
  ],
  "$id": "wallio/api/SubscriptionInput@0.3.0"
}
