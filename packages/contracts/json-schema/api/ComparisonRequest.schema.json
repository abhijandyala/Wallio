{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "profileVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "incumbentToolId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidateToolIds": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "weights": {
      "type": "object",
      "properties": {
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "privacy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "switching": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "quality",
        "fit",
        "cost",
        "privacy",
        "switching"
      ]
    },
    "spendCapMinor": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "idempotencyKey",
    "profileVersionId",
    "workflowId",
    "taskId",
    "incumbentToolId",
    "candidateToolIds"
  ],
  "$id": "wallio/api/ComparisonRequest@0.2.1"
}
