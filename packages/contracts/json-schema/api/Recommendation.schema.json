{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profileVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "calculationVersion": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "goal": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "keep",
        "try",
        "compare_further",
        "replace_after_validation",
        "review_renewal",
        "no_action"
      ]
    },
    "targetToolId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "headline": {
      "type": "string",
      "maxLength": 160
    },
    "statements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "supporting",
              "counter",
              "uncertainty",
              "next_step"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "userInputRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "role",
          "evidenceIds",
          "userInputRefs"
        ]
      }
    },
    "candidates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "toolId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "role": {
            "type": "string",
            "enum": [
              "incumbent",
              "candidate"
            ]
          },
          "accessMode": {
            "type": "string",
            "enum": [
              "researched",
              "tested_integration",
              "tested_owned_demo"
            ]
          },
          "hardConstraints": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "failures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "passed",
              "failures"
            ]
          },
          "score": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "components": {
                    "type": "object",
                    "properties": {
                      "quality": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "weight": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "evidenceIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            }
                          }
                        },
                        "required": [
                          "value",
                          "weight",
                          "evidenceIds"
                        ]
                      },
                      "fit": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "weight": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "evidenceIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            }
                          }
                        },
                        "required": [
                          "value",
                          "weight",
                          "evidenceIds"
                        ]
                      },
                      "cost": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "weight": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "evidenceIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            }
                          }
                        },
                        "required": [
                          "value",
                          "weight",
                          "evidenceIds"
                        ]
                      },
                      "privacy": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "weight": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "evidenceIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            }
                          }
                        },
                        "required": [
                          "value",
                          "weight",
                          "evidenceIds"
                        ]
                      },
                      "switching": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "weight": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "evidenceIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            }
                          }
                        },
                        "required": [
                          "value",
                          "weight",
                          "evidenceIds"
                        ]
                      }
                    },
                    "required": [
                      "quality",
                      "fit",
                      "cost",
                      "privacy",
                      "switching"
                    ]
                  }
                },
                "required": [
                  "min",
                  "max",
                  "components"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "known": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needsTesting": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testResult": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "evidenceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "passed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "attempts": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "medianLatencyMs": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "evidenceId",
                  "passed",
                  "attempts",
                  "medianLatencyMs"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "toolId",
          "role",
          "accessMode",
          "hardConstraints",
          "score",
          "known",
          "missing",
          "needsTesting",
          "testResult"
        ]
      }
    },
    "spending": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "monthlyEquivalentDeltaMinor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "immediateCashSavingMinor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "renewalAvoidanceMinor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "assumptions": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "label",
              "monthlyEquivalentDeltaMinor",
              "immediateCashSavingMinor",
              "renewalAvoidanceMinor",
              "assumptions"
            ]
          }
        }
      },
      "required": [
        "currency",
        "scenarios"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "limitations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "runId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "vendor_claim",
              "observed_behavior",
              "executed_test",
              "user_input"
            ]
          },
          "candidateToolId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "accessMode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "researched",
                  "tested_integration",
                  "tested_owned_demo"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "canonicalUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "contentHash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "hasScreenshot": {
            "type": "boolean"
          },
          "extractionMethod": {
            "type": "string",
            "enum": [
              "dom",
              "vision",
              "api",
              "manual"
            ]
          },
          "excerpt": {
            "type": "string",
            "maxLength": 2000
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "runId",
          "kind",
          "candidateToolId",
          "accessMode",
          "url",
          "canonicalUrl",
          "capturedAt",
          "contentHash",
          "hasScreenshot",
          "extractionMethod",
          "excerpt",
          "limitation"
        ]
      }
    }
  },
  "required": [
    "id",
    "runId",
    "profileVersionId",
    "calculationVersion",
    "createdAt",
    "goal",
    "action",
    "targetToolId",
    "headline",
    "statements",
    "candidates",
    "spending",
    "confidence",
    "limitations",
    "evidence"
  ],
  "$id": "wallio/api/Recommendation@0.2.1"
}
