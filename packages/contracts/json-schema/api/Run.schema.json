{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "QUEUED",
        "PREPARING",
        "RUNNING",
        "AWAITING_APPROVAL",
        "VERIFYING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED",
        "CLEANING",
        "CLEANED",
        "CLEANUP_FAILED"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "partial",
        "failed",
        "timed_out",
        "cancelled"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "planning",
        "researching",
        "testing",
        "verifying",
        "reporting",
        "done"
      ]
    },
    "cleanup": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "cleaned",
        "failed"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "lastEventSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "coverage": {
      "type": "object",
      "properties": {
        "evidenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidatesResearched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidatesTested": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "evidenceCount",
        "candidatesResearched",
        "candidatesTested"
      ]
    },
    "spend": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "reservedMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actualMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capMinor": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "currency",
        "reservedMinor",
        "actualMinor",
        "capMinor"
      ]
    },
    "pendingApprovalId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "recommendationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "validation_failed",
                "unauthorized",
                "forbidden",
                "not_found",
                "conflict",
                "idempotency_conflict",
                "budget_exceeded",
                "quota_exceeded",
                "rate_limited",
                "inference_unavailable",
                "inference_invalid_output",
                "runner_unavailable",
                "runner_timeout",
                "policy_denied",
                "approval_required",
                "approval_expired",
                "approval_invalid",
                "internal"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "correlationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message",
            "correlationId",
            "retryable"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "status",
    "outcome",
    "stage",
    "cleanup",
    "createdAt",
    "updatedAt",
    "deadlineAt",
    "lastEventSeq",
    "coverage",
    "spend",
    "pendingApprovalId",
    "recommendationId",
    "error"
  ],
  "$id": "wallio/api/Run@0.1.0"
}
