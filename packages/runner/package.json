{
  "name": "@wallio/runner",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./approval": "./src/approval/token.ts"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/unit/**/*.test.ts\"",
    "test:docker": "RUNNER_DOCKER_TESTS=1 node --test --test-concurrency=1 --test-timeout=600000 \"test/docker/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/build-images.ts",
    "dev": "node --env-file-if-exists=../../.env.runner --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env.runner src/main.ts",
    "smoke": "node --env-file-if-exists=../../.env.runner scripts/smoke.ts",
    "preflight": "node --env-file-if-exists=../../.env.runner scripts/preflight.ts",
    "sentinel": "node sentinel/sentinel.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@wallio/contracts": "0.1.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright-core": "1.64.1",
    "typescript": "^5.9.3"
  }
}
