# Wallio egress proxy. Node built-ins only, no npm dependencies.
FROM node:24-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
ENV NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning
WORKDIR /proxy
COPY src/egress/proxy.ts src/egress/ip-policy.ts ./
USER node
EXPOSE 3128 3129
CMD ["node", "/proxy/proxy.ts"]
